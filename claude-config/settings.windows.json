{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": true,
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./.aws/credentials)",
      "Read(./.ssh/id_*)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/id_*)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(type .env*)",
      "Bash(Get-Content .env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"%CLAUDE_PROJECT_DIR%\\.claude\\hooks\\pre-bash-security.ps1\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"%CLAUDE_PROJECT_DIR%\\.claude\\hooks\\pre-write-secret-scan.ps1\""
          }
        ]
      }
    ]
  }
}
