{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": true,
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./.aws/credentials)",
      "Read(./.ssh/id_*)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/id_*)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(cat ~/.aws/credentials)",
      "Bash(cat ~/.ssh/id_*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__CLAUDE_HOOKS_DIR__/pre-bash-security.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__CLAUDE_HOOKS_DIR__/pre-write-secret-scan.sh\""
          }
        ]
      }
    ]
  }
}
